# Rust
/target/
**/*.rs.bk

# macOS
.DS_Store
.AppleDouble
.LSOverride

# IDE / Editor
.idea/
.vscode/
*.swp
*.swo
*~

# Env / secrets
.env
.env.*
!.env.example

# Personal agent-fleet config — NEVER published.
# Holds live OpenRouter / Playwright-MCP keys and Directus admin tokens.
# Only `config-home.example/` is tracked.
/config-home/

# Belt-and-braces: catch a credential dropped into a tracked path.
# A false positive costs one `git add -f`; a false negative costs a permanent public leak.
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519
.npmrc
credentials.json

# Logs
*.log

# TypeScript reference implementation (1.1GB) — read-only reference, never committed
.old/

# Plugin (omo) runtime state written into the repo root during test runs
.omo/

# Working scratchpad / notepad
.ulw/

# Prebuilt release binaries staged for the npm platform packages (38MB each).
# Publish them with `npm publish` from npm/platform/<target>/, never commit them.
/npm/platform/*/bin/
